# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (REQUIRED) ---
# Local Postgres OR Supabase connection string (Project Settings → Database → URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/awaaz
# Set true for Supabase / hosted Postgres that requires SSL (auto-detected for *.supabase.*)
DATABASE_SSL=false

# --- Supabase (OPTIONAL — reserved for future storage/auth, not used in v1) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- AI (OPTIONAL — any OpenAI-compatible API) ---
# If empty, the deterministic multilingual fallback classifier is used (always works).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000

# --- CORS: comma-separated allowed frontend origins (REQUIRED in production) ---
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# --- Debug: include AI/fallback metadata in the create-complaint response ---
INCLUDE_AI_META=false